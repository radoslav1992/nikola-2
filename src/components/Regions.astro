---
/** "Discover Bulgaria": horizontal region cards; clicking one opens its local guide + properties below. */
import { T, REGION_COPY, href } from '../lib/i18n.js';
import PropertyCard from './PropertyCard.astro';
const { regions = [] } = Astro.props;
const lang = Astro.locals.lang || 'bg';
const t = T[lang];
const photoOf = (g) => {
  const l = g.items.find((x) => /къщ|вил/i.test(x.type) && x.images?.length) || g.items.find((x) => x.images?.length);
  return l?.images?.[0] || null;
};
---
<section id="regions" class="regions">
  <div class="wrap regions-head">
    <div>
      <div class="kicker">{t.discoverKicker}</div>
      <h2 class="display">{t.discoverTitle(regions.length)}</h2>
    </div>
    <p class="regions-body">{t.discoverBody}</p>
  </div>
  <div class="region-row noscroll" data-region-row>
    {regions.map((g) => {
      const c = REGION_COPY[g.key];
      const img = photoOf(g);
      return (
        <button type="button" class="region-card" data-region={g.key} aria-expanded="false" aria-controls={`region-${g.key}`}>
          {img && <img src={`/img/medium/${encodeURIComponent(img)}`} alt="" loading="lazy" width="600" height="760" />}
          <span class="count">{g.count} {t.propsCount(g.count)}</span>
          <span class="region-text">
            <span class="region-name">{c.name[lang]}</span>
            <span class="region-tag">{c.tagline[lang]}</span>
          </span>
        </button>
      );
    })}
  </div>
  <div class="wrap">
    {regions.map((g) => {
      const c = REGION_COPY[g.key];
      return (
        <div class="region-guide" id={`region-${g.key}`} data-region-panel={g.key} hidden>
          <div class="guide-text">
            <div class="kicker">{t.localGuide}</div>
            <h3 class="display">{c.name[lang]}</h3>
            <p>{c.guide[lang]}</p>
            <div class="facts">{c.facts[lang].map((f) => <span>{f}</span>)}</div>
            <div class="guide-actions">
              <a class="btn btn-dark" href={href(lang, `/imoti?region=${g.key}`)}>{t.allInRegion} ({g.count}) →</a>
              <button type="button" class="btn btn-outline" data-region-close>{t.close}</button>
            </div>
          </div>
          <div class="guide-props">
            {g.items.slice(0, 3).map((l) => <PropertyCard listing={l} variant="mini" />)}
          </div>
        </div>
      );
    })}
  </div>
</section>
