---
/**
 * Catalogue card (design: "Mobile catalogue" card) — tall photo, tag chips, favourite, price + meta row.
 * `variant="mini"` renders the compact card used inside region guides and "similar properties".
 */
import { T, fmtPrice, fmtNumber, placeLabel, metaBits, listingTags, listingHref, imgUrl } from '../lib/i18n.js';
const { listing: l, variant = 'card', eager = false } = Astro.props;
const lang = Astro.locals.lang || 'bg';
const t = T[lang];
const imgs = (l.images || []).slice(0, 5);
const tags = listingTags(l, lang).slice(0, variant === 'mini' ? 1 : 3);
const meta = metaBits(l, lang);
const url = listingHref(l, lang);
---
{variant === 'mini' ? (
  <a class="mini-card" href={url}>
    <div class="mini-media">{imgs[0] ? <img src={imgUrl(imgs[0], 'medium')} alt={l.title} loading="lazy" width="400" height="260" /> : <div class="noimg" />}</div>
    <div class="mini-body">
      <div class="mini-price">{l.oldPrice && <s>€{fmtNumber(l.oldPrice)}</s>}{fmtPrice(l, lang)}</div>
      <div class="mini-title">{l.title}</div>
      <div class="mini-meta">{[placeLabel(l.place, lang), ...meta.slice(0, 2)].join(' · ')}</div>
    </div>
  </a>
) : (
  <article class="pcard" data-id={l.id}>
    <a class="pcard-media" href={url} data-carousel={imgs.length > 1 ? '' : undefined}>
      {imgs.length ? (
        <div class="slides">{imgs.map((f, i) => <img src={imgUrl(f, 'medium')} alt={`${t.photoOf(i + 1, imgs.length)}: ${l.title}`} loading={eager && i === 0 ? 'eager' : 'lazy'} decoding="async" width="600" height="660" class:list={{ on: i === 0 }} />)}</div>
      ) : <div class="noimg" />}
      {imgs.length > 1 && <div class="zones" aria-hidden="true">{imgs.map(() => <span />)}</div>}
      {imgs.length > 1 && <div class="dots" aria-hidden="true">{imgs.map((_, i) => <i class:list={{ on: i === 0 }} />)}</div>}
      <div class="tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div>
    </a>
    <button type="button" class="fav" data-fav={l.id} aria-label={t.favourite}>♡</button>
    <div class="pcard-foot">
      <div class="min0">
        <div class="pcard-price">{l.oldPrice && <s>€{fmtNumber(l.oldPrice)}</s>}{fmtPrice(l, lang)}</div>
        <div class="pcard-meta" title={l.title}>{[placeLabel(l.place, lang), ...meta.slice(0, 2)].join(' · ')}</div>
        <div class="pcard-title">{l.title}</div>
      </div>
      <a class="arrow" href={url} aria-label={t.viewProp}>↗</a>
    </div>
  </article>
)}
