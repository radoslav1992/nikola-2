---
import Base from '../layouts/Base.astro';
import { T, href } from '../lib/i18n.js';
const lang = Astro.locals.lang || 'bg';
const t = T[lang];
Astro.response.status = 404;
---
<Base path={Astro.locals.path || '/'} title={t.notFoundTitle} noindex pageClass="notfound">
  <section class="wrap notfound-box">
    <h1 class="display">{t.notFoundTitle}</h1>
    <p class="muted lead">{t.notFoundSub}</p>
    <div class="row">
      <a class="btn btn-dark" href={href(lang, '/imoti')}>{t.navProps}</a>
      <a class="btn btn-white" href={href(lang, '/')}>{t.backHome}</a>
    </div>
  </section>
</Base>
